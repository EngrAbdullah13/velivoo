# Copy this file to .env. Do not commit .env or add AWS credentials to browser env.
NODE_ENV=development
EMAIL_PLATFORM_API_PORT=4000
EMAIL_PLATFORM_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_EMAIL_PLATFORM_API_URL=http://localhost:4000
NEXT_PUBLIC_EMAIL_PLATFORM_DEV_USER=dev-owner
NEXT_PUBLIC_EMAIL_PLATFORM_LOCAL_PASSWORD_AUTH_ENABLED=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_platform
REDIS_URL=redis://localhost:6379
# On Windows, legacy Redis often hits MISCONF/RDB write errors. Prefer Memurai, or keep
# EMAIL_PLATFORM_DELIVERY_QUEUE_ENABLED=false to use PostgreSQL-backed local proof automation.
EMAIL_PLATFORM_OBJECT_ROOT=.local/objects
# Optional: upload footer logos to a public Cloudflare R2 bucket/custom domain.
# The API token needs R2 object write permission for this bucket.
# EMAIL_PLATFORM_R2_ACCOUNT_ID=
# EMAIL_PLATFORM_R2_BUCKET=
# EMAIL_PLATFORM_R2_API_TOKEN=
# EMAIL_PLATFORM_R2_PUBLIC_BASE_URL=https://media.example.com
EMAIL_PLATFORM_ALLOW_DEV_IDENTITY=true
EMAIL_PLATFORM_LOCAL_PASSWORD_AUTH_ENABLED=true

# Server-only. Production uses IAM roles or a secure server-side secret store.
EMAIL_PROVIDER=ses
EMAIL_PLATFORM_RUNTIME_MODE=proof
EMAIL_PLATFORM_EMAIL_SEND_ENABLED=false
EMAIL_PLATFORM_SES_DOMAIN_SETUP_ENABLED=false
EMAIL_PLATFORM_SES_TENANT_MAPPING_ENABLED=false
EMAIL_PLATFORM_DELIVERY_QUEUE_ENABLED=false
# When SNS delivery callbacks are unreachable locally, mark SES accepts as delivered.
EMAIL_PLATFORM_CONFIRM_DELIVERY_WITHOUT_FEEDBACK=true
AWS_SES_REGION=us-east-1
AWS_REGION=us-east-1
# Optional server-controlled allowlist for new sending domains. The browser never
# receives credentials and cannot submit a region outside this list.
EMAIL_PLATFORM_SES_SUPPORTED_REGIONS=us-east-1

EMAIL_PLATFORM_PUBLIC_BASE_URL=http://localhost:4001
EMAIL_PLATFORM_UNSUBSCRIBE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
EMAIL_PLATFORM_TRACKING_SIGNING_SECRET=replace-with-a-different-at-least-32-byte-secret
EMAIL_PLATFORM_API_KEY_PEPPER=replace-with-a-long-local-api-key-pepper
# New branded sending domains. Missing values disable only branded-domain
# create/recheck; legacy domains and all other services continue to run.
DNS_PROVIDER=disabled
ROUTE53_DNS_ENABLED=false
ROUTE53_BRANDED_NS_DOMAIN=
ROUTE53_DELEGATION_SET_ID=
ROUTE53_EXPECTED_NAME_SERVERS=
# JSON object mapping vanity name server names to the fixed Route 53 reusable
# delegation-set name servers, or comma-separated vanity=provider pairs.
ROUTE53_VANITY_NS_MAPPING=
SENDING_DOMAIN_PREFIX=send
SES_DEFAULT_MAIL_FROM_PREFIX=bounce
# SNS topic ARN for SES bounce/complaint/delivery events (not the subscription ARN).
# Create an HTTPS subscription in AWS to: ${EMAIL_PLATFORM_PUBLIC_BASE_URL}/public/v1/provider/ses
EMAIL_PLATFORM_SNS_TOPIC_ARN=
MANAGED_DMARC_POLICY=v=DMARC1; p=none
MANAGED_DMARC_REQUIRED=false

# Static / Branded DNS. Disabled until a Velivoo Route 53 zone exists.
VELIVOO_STATIC_BRANDED_DNS_ENABLED=false
# Apex or hosted-zone name for Velivoo DKIM infrastructure. Customer CNAME targets are always d_<id>.dkim.<apex>.
# If the hosted zone is dkim.example.com, set this to dkim.example.com or example.com — both yield d_<id>.dkim.example.com.
VELIVOO_STATIC_DNS_DOMAIN=
VELIVOO_STATIC_DNS_ZONE_ID=
VELIVOO_STATIC_SEND_DNS_DOMAIN=
VELIVOO_STATIC_SEND_DNS_ZONE_ID=
VELIVOO_STATIC_SEND_ROUTING_TARGET=
VELIVOO_DKIM_KEY_ENCRYPTION_SECRET=

# Worker queue scan interval (ms). Verification runs on Recheck DNS or provider webhooks, not on a timer loop.
EMAIL_PLATFORM_DOMAIN_VERIFICATION_POLL_MS=30000
EMAIL_PLATFORM_DOMAIN_VERIFICATION_LEASE_MS=120000

# cloudfront_saas uses one shared multi-tenant distribution and one distribution
# tenant per branded hostname. Use platform for local/staged global tracking.
TRACKING_DOMAIN_MODE=platform
TRACKING_DOMAIN_PREFIX=click
TRACKING_ORIGIN_DOMAIN=
CLOUDFRONT_MULTI_TENANT_DISTRIBUTION_ID=
CLOUDFRONT_CONNECTION_GROUP_ID=
